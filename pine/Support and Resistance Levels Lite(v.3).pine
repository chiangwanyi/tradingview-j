
 //@version=4
study("Support and Resistance Levels Lite(v.3)", overlay=true)

// Doji 参数
dojiSize = input(0.15, "Doji Size", minval=0.01, step=0.01)

// Doji 判断逻辑
doji = abs(open - close) <= (high - low) * dojiSize

// 绘制 X：阴线在上方，阳线在下方
stop = "✖"

plotchar((open - close) < 0 ? doji : na, title="", char=stop, location=location.abovebar, color=color.black)
plotchar((open - close) > 0 ? doji : na, title="", char=stop, location=location.belowbar, color=color.black)
